<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Safarion.Views.DashboardPage"
             BackgroundColor="#F8F9FA"
             Shell.NavBarIsVisible="False"
             Title="Home">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#2F0518</Color>
            <Color x:Key="Secondary">#E91E63</Color>
            <Color x:Key="AccentBlue">#2196F3</Color>
            <Color x:Key="CardBackground">White</Color>
            <Color x:Key="TextDark">#2C3E50</Color>
            <Color x:Key="TextLight">#7F8C8D</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <Grid RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="0">

            <!-- HEADER -->
            <Grid Grid.Row="0" BackgroundColor="{StaticResource Primary}" Padding="25,30,25,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top Row -->
                <Grid ColumnDefinitions="*, Auto, Auto, Auto" ColumnSpacing="12" VerticalOptions="Center">

                    <!-- Greeting -->
                    <StackLayout Spacing="2">
                        <Label x:Name="DateLabel"
                               TextColor="{StaticResource Secondary}"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextTransform="Uppercase"/>

                        <Label x:Name="GreetingLabel"
                               TextColor="White"
                               FontSize="22"
                               FontAttributes="Bold"/>
                    </StackLayout>

                    <!-- Profile Circle -->
                    <Border Grid.Column="1"
                            Stroke="{StaticResource Secondary}"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 32"
                            HeightRequest="64"
                            WidthRequest="64"
                            BackgroundColor="{StaticResource Primary}"
                            VerticalOptions="Center">

                        <Grid>
                            <Image x:Name="ProfileImage"
                                   Source="profile.png"
                                   Aspect="AspectFill"
                                   IsVisible="False"/>

                            <Label x:Name="ProfileInitialLabel"
                                   Text="T"
                                   TextColor="White"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnProfileTapped"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Hamburger Menu with Badge -->
                    <Grid Grid.Column="3"
                        WidthRequest="40"
                        HeightRequest="40"
                        VerticalOptions="Center">

                        <!-- Your ORIGINAL Border -->
                        <Border BackgroundColor="Transparent"
                            StrokeThickness="0"
                            VerticalOptions="Center">

                            <Label Text="☰"
                                FontSize="32"
                                FontAttributes="Bold"
                                TextColor="White"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"/>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMenuClicked"/>
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- Notification Badge -->
                        <Frame x:Name="NotificationBadge"
                            WidthRequest="10"
                            HeightRequest="10"
                            CornerRadius="5"
                            BackgroundColor="Red"
                            HorizontalOptions="End"
                            VerticalOptions="Start" 
                            TranslationX="5"
                            TranslationY="-5"
                            Padding="0"
                            HasShadow="False"
                            IsVisible="False"/>
                    </Grid>

                </Grid>

                <!--
                <Border Grid.Row="1"
                        Margin="0,25,0,0"
                        BackgroundColor="#451D2F"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 15">

                    <Grid ColumnDefinitions="50,*" Padding="10">
                        <Frame CornerRadius="15"
                               HeightRequest="30"
                               WidthRequest="30"
                               BackgroundColor="{StaticResource Primary}"
                               Padding="0"
                               HasShadow="False"
                               VerticalOptions="Center"
                               HorizontalOptions="Center">

                            <Label Text="🛡️"
                                   FontSize="16"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>

                        <StackLayout Grid.Column="1"
                                     VerticalOptions="Center"
                                     Spacing="0">

                            <Label Text="STATUS: SECURE"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   FontSize="14"/>

                            <Label Text="You are in a verified safe zone."
                                   TextColor="#B0BEC5"
                                   FontSize="12"/>
                        </StackLayout>
                    </Grid>
                </Border>
                -->
                
            </Grid>


            <!-- Emergency / Voice / Map -->
            <Grid Grid.Row="1" Padding="20" RowSpacing="15" Margin="0,-30,0,0">

                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="160,160"
                      ColumnSpacing="15"
                      RowSpacing="15">

                    <Border Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            StrokeShape="RoundRectangle 20"
                            BackgroundColor="#D32F2F"
                            StrokeThickness="0">

                        <Grid>
                            <Image Source="sos_cover.png"
                                   Aspect="AspectFill"
                                   Opacity="0.5"/>

                            <StackLayout VerticalOptions="Center"
                                         HorizontalOptions="Center"
                                         Spacing="5">

                                <Label Text="🚨" FontSize="40"/>
                                <Label Text="EMERGENCY SOS"
                                       TextColor="White"
                                       FontAttributes="Bold"
                                       FontSize="22"/>
                                <Label Text="Tap or shake to alert contacts"
                                       TextColor="#FFCDD2"
                                       FontSize="12"/>
                            </StackLayout>

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSOSTapped"/>
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Grid.Column="0"
                            StrokeShape="RoundRectangle 20"
                            BackgroundColor="{StaticResource AccentBlue}"
                            StrokeThickness="0">

                        <StackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Spacing="5">

                            <Label Text="🎙️" FontSize="32"/>
                            <Label Text="Voice SOS"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   FontSize="16"/>
                            <Label Text="Say 'Help'"
                                   TextColor="#BBDEFB"
                                   FontSize="11"/>
                        </StackLayout>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnVoiceTapped"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <Border Grid.Row="1"
                            Grid.Column="1"
                            StrokeShape="RoundRectangle 20"
                            BackgroundColor="{StaticResource Primary}"
                            StrokeThickness="0">

                        <StackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Spacing="5">

                            <Label Text="🗺️" FontSize="32"/>
                            <Label Text="Safe Map"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   FontSize="16"/>
                            <Label Text="Live Tracking"
                                   TextColor="#B0BEC5"
                                   FontSize="11"/>
                        </StackLayout>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMapTapped"/>
                        </Border.GestureRecognizers>
                    </Border>

                </Grid>
            </Grid>

            <StackLayout Grid.Row="2" Padding="0,3,0,30" Spacing="15">

                <Label Text="Explore Destinations"
           TextColor="{StaticResource TextDark}"
           FontSize="18"
           FontAttributes="Bold"
           Margin="25,0"/>

                <CollectionView x:Name="DestinationList"
                    Margin="15,0"
                    HorizontalScrollBarVisibility="Never">

                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal"
                               ItemSpacing="18"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>

                        <DataTemplate>

                            <Grid WidthRequest="150"
                      HeightRequest="190">

                                <!-- NORMAL DESTINATION CARD -->
                                <Border StrokeShape="RoundRectangle 18"
                            BackgroundColor="#1A1A1A"
                            StrokeThickness="0">

                                    <Grid>

                                        <Image Source="{Binding Image}"
                                   Aspect="AspectFill"
                                   Opacity="0.7"/>

                                        <Label Text="{Binding Name}"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   VerticalOptions="End"
                                   Margin="12"/>

                                    </Grid>

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnDestinationTapped"/>
                                    </Border.GestureRecognizers>

                                </Border>

                                <!-- CLOSE BUTTON -->
                                <Button Text="✕"
                            WidthRequest="28"
                            HeightRequest="28"
                            FontSize="12"
                            CornerRadius="14"
                            BackgroundColor="#CC000000"
                            TextColor="White"
                            HorizontalOptions="End"
                            VerticalOptions="Start"
                            Margin="6"
                            Clicked="OnRemoveDestination"/>

                            </Grid>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                    <!-- ADD CARD -->
                    <CollectionView.Footer>

                        <Grid WidthRequest="150"
                  HeightRequest="190">

                            <Border StrokeShape="RoundRectangle 18"
                        BackgroundColor="#F1F1F1"
                        Stroke="#CCCCCC"
                        StrokeThickness="2">

                                <StackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="6">

                                    <Label Text="+"
                               FontSize="40"
                               TextColor="#888"/>

                                    <Label Text="Add"
                               FontSize="14"
                               TextColor="#888"/>

                                </StackLayout>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAddDestination"/>
                                </Border.GestureRecognizers>

                            </Border>

                        </Grid>

                    </CollectionView.Footer>

                </CollectionView>

            </StackLayout>
            
            
            <Grid Grid.Row="3" BackgroundColor="{StaticResource Primary}" Padding="25,20,25,50" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0"
                        Text="📢  See Safety Reviews" 
                        Clicked="OnReviewsClicked"
                        BackgroundColor="White" 
                        TextColor="{StaticResource Primary}"
                        CornerRadius="25"
                        HeightRequest="50"
                        FontAttributes="Bold"
                        ImageSource="diary_icon.png"/>

                <BoxView Grid.Row="1" HeightRequest="1" Color="#4A1828" Margin="0,10"/>

                <StackLayout Grid.Row="2" Spacing="8">
                    <Label x:Name="AboutTextLabel"
       Text="Saforion is an AI-driven safety and travel companion designed specifically for solo explorers who seek freedom and adventure—but also need reliable protection throughout their journey. Solo travel often comes with safety concerns, especially for women, students, backpackers, and elderly travelers who may face risks such as unsafe routes, difficulty calling for help, or lack of support during emergencies.

Saforion addresses these challenges through an intelligent, always-ready safety system powered by real-time monitoring, voice-activated emergency detection, and AI-based decision support. Whether a traveler is navigating unfamiliar locations, walking alone at night, or exploring areas with poor network connectivity, Saforion ensures help is always within reach.

The app automatically detects distress using voice-based SOS recognition, continuously updates the user’s position through live GPS tracking, and instantly notifies trusted contacts via SMS or email alerts. Even in low-network areas, Saforion’s offline emergency mode stores critical SOS requests and sends them once connectivity is restored.

Beyond safety, Saforion enhances travel experiences by offering trusted route suggestions, local cultural insights, festival updates, and nearby traveler mapping, helping users explore confidently and responsibly.

Saforion bridges the gap between the independence of solo travel and the need for real-time support—ensuring every journey is safer, smarter, and more empowering."
       TextColor="#B0BEC5"
       FontSize="14"
       LineHeight="1.3"
       MaxLines="10"
       LineBreakMode="WordWrap"/>

                    <Label x:Name="ReadMoreLabel"
       Text="Read full mission statement..."
       TextColor="{StaticResource Secondary}"
       FontSize="12"
       FontAttributes="Bold"
       TextDecorations="Underline">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnReadMoreTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </StackLayout>

                <StackLayout Grid.Row="3" Spacing="10" Margin="0,20,0,0">
                    <Label Text="Contact Us" TextColor="White" FontSize="16" FontAttributes="Bold"/>
                    <StackLayout Orientation="Horizontal" Spacing="10">
                        <Label Text="📧" FontSize="16" TextColor="White"/>
                        <Label Text="support@safarion.app" TextColor="#B0BEC5" FontSize="14"/>
                    </StackLayout>
                    <StackLayout Orientation="Horizontal" Spacing="10">
                        <Label Text="📞" FontSize="16" TextColor="White"/>
                        <Label Text="+1 (800) SAFARION" TextColor="#B0BEC5" FontSize="14"/>
                    </StackLayout>

                    <Label Text="SAFARION" HorizontalOptions="Center" TextColor="Beige" FontSize="20" Margin="0,6,0,0" FontFamily="Italics"/>
                </StackLayout>

            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>