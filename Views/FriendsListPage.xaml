<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Safarion.Views.FriendsListPage"
             Title="My Tribe"
             BackgroundColor="#121212">

    <Grid RowDefinitions="Auto, *">

        <StackLayout Grid.Row="0" Padding="25,20,25,10" Spacing="5">
            <Label Text="Your Connections" TextColor="White" FontSize="28" FontAttributes="Bold"/>
            <Label Text="Stay safe together" TextColor="#00E676" FontSize="14" FontAttributes="Italic"/>
        </StackLayout>

        <StackLayout x:Name="LoadingView" Grid.Row="1" VerticalOptions="Center" HorizontalOptions="Center" Spacing="15" IsVisible="False">
            <ActivityIndicator IsRunning="True" Color="#00E676" HeightRequest="40" WidthRequest="40"/>
            <Label Text="Syncing tribe..." TextColor="#B0BEC5" FontSize="14"/>
        </StackLayout>

        <CollectionView x:Name="FriendsList" Grid.Row="1" Margin="15,0" IsVisible="False">

            <CollectionView.EmptyView>
                <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20" Padding="30">

                    <Frame BackgroundColor="#1E1E1E" CornerRadius="50" HeightRequest="100" WidthRequest="100" HasShadow="False" BorderColor="Transparent" HorizontalOptions="Center">
                        <Label Text="🌍" FontSize="45" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Frame>

                    <Label Text="No friends yet" TextColor="White" FontSize="22" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                    <Label Text="Build your safety network. Add travelers to see their live location and chat instantly." 
                           TextColor="#B0BEC5" FontSize="14" LineHeight="1.3" HorizontalTextAlignment="Center" Margin="0,0,0,10"/>

                    <Button Text="Find Travelers Nearby" 
                            BackgroundColor="#00E676" 
                            TextColor="#121212" 
                            FontAttributes="Bold"
                            CornerRadius="25"
                            HeightRequest="50"
                            Padding="20,0"
                            Clicked="OnFindClicked"/>
                </StackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeShape="RoundRectangle 15"
                BackgroundColor="#1E1E1E"
                Margin="0,6"
                Padding="15">

                        <Grid ColumnDefinitions="50, *, Auto, Auto, Auto"
                  ColumnSpacing="12">

                            <!-- Avatar -->
                            <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 25"
                        HeightRequest="50"
                        WidthRequest="50"
                        BackgroundColor="#333">

                                <Label Text="{Binding Initial}"
                           TextColor="#00E676"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                            </Border>

                            <!-- Name -->
                            <StackLayout Grid.Column="1"
                             VerticalOptions="Center"
                             Spacing="2">
                                <Label Text="{Binding SenderName}"
                           TextColor="White"
                           FontSize="16"
                           FontAttributes="Bold"
                           LineBreakMode="TailTruncation"/>

                                <Label Text="● Active"
                           TextColor="#00E676"
                           FontSize="11"/>
                            </StackLayout>

                            <!-- Diary -->
                            <Button Grid.Column="2"
                        Text="📓"
                        BackgroundColor="#2C2C2C"
                        TextColor="White"
                        HeightRequest="40"
                        WidthRequest="40"
                        CornerRadius="20"
                        Clicked="OnViewDiaryClicked"
                        CommandParameter="{Binding .}"/>

                            <!-- Chat -->
                            <Button Grid.Column="3"
                        Text="💬"
                        BackgroundColor="#2C2C2C"
                        TextColor="White"
                        HeightRequest="40"
                        WidthRequest="40"
                        CornerRadius="20"
                        Clicked="OnChatClicked"
                        CommandParameter="{Binding .}"/>

                            <!-- Track -->
                            <Button Grid.Column="4"
                        Text="📍"
                        BackgroundColor="#00C853"
                        TextColor="Black"
                        HeightRequest="40"
                        WidthRequest="40"
                        CornerRadius="20"
                        Clicked="OnTrackClicked"
                        CommandParameter="{Binding .}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>