<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Safarion.Views.TravelDiaryPage"
             Title="My Travel Diary"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="*, Auto" Padding="15">
        <CollectionView x:Name="MemoriesList">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="15"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame CornerRadius="15" Padding="0" HasShadow="True">
                        <Grid RowDefinitions="180, Auto, Auto" ColumnDefinitions="*, Auto, Auto">

                            <Image Grid.Row="0" Grid.ColumnSpan="3" Source="{Binding CoverImage}" Aspect="AspectFill" HeightRequest="180"/>

                            <!-- Privacy Badge -->
                            <Border Grid.Row="0" 
                                    BackgroundColor="{Binding PrivacyColor}" 
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="8,4"
                                    Margin="10"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Start">
                                <StackLayout Orientation="Horizontal" Spacing="4">
                                    <Label Text="{Binding PrivacyIcon}" FontSize="12"/>
                                    <Label Text="{Binding PrivacyText}" 
                                           TextColor="White" 
                                           FontSize="11" 
                                           FontAttributes="Bold"/>
                                </StackLayout>
                            </Border>

                            <Label Grid.Row="1" Grid.Column="0" Text="{Binding Title}" FontAttributes="Bold" FontSize="18" Padding="15,10,0,0"/>

                            <Button Grid.Row="1" Grid.Column="1" Text="Edit" HeightRequest="28" WidthRequest="70" CornerRadius="14" Margin="0,10,10,0" CommandParameter="{Binding .}" Clicked="OnEditClicked" BackgroundColor="#E0E0E0" TextColor="Black" FontSize="13" Padding="0" VerticalOptions="Center"/>


                            <ImageButton Grid.Row="1" Grid.Column="2" Source="delete_icon.png" HeightRequest="25" WidthRequest="25" Margin="0,10,15,0"
                                         CommandParameter="{Binding .}" Clicked="OnDeleteClicked"/>

                            <Label Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding StartDate, StringFormat='{0:MMM dd, yyyy}'}" TextColor="Black" Padding="15,0,0,15"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="1" Text="+ New Memory" Clicked="OnAddMemoryClicked" 
                BackgroundColor="#2F0518" TextColor="White" HeightRequest="50" CornerRadius="25" Margin="0,10,0,0"/>
    </Grid>
</ContentPage>